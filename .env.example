# Senac ResourceHub — variáveis de ambiente
#
# Nenhuma credencial real deve ser commitada neste arquivo.
# Copie para .env.local antes de preencher valores reais:
#   cp .env.example .env.local

# --- Públicas (expostas ao navegador — prefixo NEXT_PUBLIC_) -----------------
# URL e chave anônima do projeto Supabase. A anon key é segura para o
# navegador: todo o acesso a dados é controlado por Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Exclusivas de servidor (NUNCA usar em código de Client Component) ------
# service_role key: ignora RLS por completo. Usada apenas em código de
# servidor (Server Actions/Route Handlers) para operações administrativas,
# como remover credenciais de auth.users na exclusão de conta. Nunca prefixar
# com NEXT_PUBLIC_ (isso a exporia ao bundle do navegador).
SUPABASE_SERVICE_ROLE_KEY=
