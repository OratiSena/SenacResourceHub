# Senac ResourceHub — variáveis de ambiente
#
# Este arquivo contém somente os nomes das variáveis esperadas pela aplicação.
# Nenhuma credencial real deve ser commitada aqui.
#
# Para desenvolvimento local:
# 1. copie este arquivo para .env.local
# 2. preencha os valores reais somente em .env.local
#
# O arquivo .env.local é ignorado pelo Git.

# -----------------------------------------------------------------------------
# Supabase — valores públicos
# -----------------------------------------------------------------------------
# Estes valores podem ser utilizados pela aplicação no navegador.
# O acesso aos dados continua protegido pelas políticas de Row Level Security
# (RLS) configuradas no Supabase.

# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key atual do Supabase (substitui a antiga anon key).
# Usada tanto pelo browser client quanto pelo server client autenticado.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Supabase — valores privados de servidor
# -----------------------------------------------------------------------------
# Nenhuma chave administrativa é necessária nesta etapa.
#
# Se futuramente o projeto precisar executar operações privilegiadas no
# servidor, será utilizada uma Secret Key atual do Supabase, armazenada
# exclusivamente no ambiente do servidor e nunca exposta com NEXT_PUBLIC_.
